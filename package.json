{
  "name": "sweatdrop",
  "version": "1.0.0",
  "private": true,
  "description": "SweatDrop - Fitness tracking platform",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "ensure-deps": "./scripts/ensure-deps.sh",
    "dev:mobile": "pnpm --filter sweatdrop-mobile-app start",
    "dev:admin": "pnpm --filter sweatdrop-admin-panel dev",
    "dev:landing": "pnpm --filter sweatdrop-landing-page dev",
    "build:mobile": "pnpm --filter sweatdrop-mobile-app build",
    "build:admin": "pnpm --filter sweatdrop-admin-panel build",
    "build:landing": "pnpm --filter sweatdrop-landing-page build",
    "ios:prebuild": "expo prebuild apps/mobile-app --platform ios",
    "ios:setup": "cd apps/mobile-app/ios && rm -rf Pods Podfile.lock && export LANG=en_US.UTF-8 && arch -arm64 pod install",
    "ios:clean": "cd apps/mobile-app/ios && rm -rf Pods Podfile.lock ~/Library/Developer/Xcode/DerivedData/SweatDrop-* && echo 'Cleaned iOS build artifacts'",
    "ios:xcode": "open apps/mobile-app/ios/SweatDrop.xcworkspace",
    "ios:build": "pnpm ios:prebuild && pnpm ios:setup && pnpm ios:xcode",
    "admin:build": "cd apps/admin-panel && pnpm build",
    "admin:dev": "cd apps/admin-panel && pnpm dev",
    "lint": "pnpm --recursive lint",
    "type-check": "pnpm --recursive type-check",
    "test:db": "node scripts/testing/run-suite.cjs db",
    "test:mobile": "node scripts/testing/run-suite.cjs mobile",
    "test:admin": "node scripts/testing/run-suite.cjs admin",
    "test:e2e": "node scripts/testing/run-suite.cjs e2e",
    "test:smoke": "node scripts/testing/run-smoke.cjs",
    "test:mobile-gates": "node scripts/testing/verify-mobile-gates.cjs",
    "test:release-preflight": "node scripts/testing/release-preflight.cjs",
    "test:fixtures:reset": "node scripts/testing/fixtures-reset.cjs",
    "test:fixtures:seed": "node scripts/testing/fixtures-seed.cjs",
    "test:ci": "node scripts/testing/run-ci.cjs",
    "env:mobile:dev": "node scripts/use-mobile-env.cjs dev",
    "env:mobile:prod": "node scripts/use-mobile-env.cjs prod",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.0",
      "@types/react-dom": "^18.3.0"
    }
  },
  "dependencies": {
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
