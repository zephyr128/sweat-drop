# Admin panel — use dev Supabase for local / preview deployments; prod project for production only.
# See docs/plans/production_env_split_dev_prod_runbook.md
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (optional; staff/owner invites log URL when unset)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="SweatDrop <noreply@sweatdrop.com>"

# Optional public URLs for store listings and ops cross-check (no secrets).
# Host Privacy Policy and Terms on your marketing site or CMS; paste HTTPS URLs here.
# NEXT_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
# NEXT_PUBLIC_TERMS_OF_SERVICE_URL=https://example.com/terms
# NEXT_PUBLIC_SUPPORT_URL=https://example.com/support
