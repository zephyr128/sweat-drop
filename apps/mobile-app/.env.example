# Copy to .env.dev.local or .env.prod.local, then select active env with:
# pnpm env:mobile:dev  OR  pnpm env:mobile:prod
# (never commit local env files)
EXPO_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key

# Build/runtime flags (use EAS env or local .env; no secrets here)
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_PUSH_ENABLED=true
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# OAuth (public client IDs only)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id

# Legal document URLs (HTTPS). Leave empty until published; app shows plain consent text / “link unavailable”.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
