# Expo
.expo/
dist/
web-build/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Android signing secrets — never commit upload keystore credentials.
# .example is intentionally tracked as a template; everything else is ignored
# (per-env sources keystore.prod.properties / keystore.dev.properties plus the
# build-time staged keystore.properties).
android/keystore.properties
android/keystore.prod.properties
android/keystore.dev.properties

# Firebase / FCM (push) — NEVER commit these
google-services.json
GoogleService-Info.plist
fcm-v1-service-account*.json

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Macos
.DS_Store
*.pem

# Local env files
.env*.local
.env
.env.dev
.env.prod

# Typescript
*.tsbuildinfo

# Node
node_modules/
