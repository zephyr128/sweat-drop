# SweatDrop Android upload keystore credentials (per-env template)
#
# Copy this file TWICE — once per environment — and fill in real values:
#   - keystore.prod.properties  (used by build-android-release.sh --env prod)
#   - keystore.dev.properties   (used by build-android-release.sh --env dev)
#
# Both copies are git-ignored and MUST NEVER be committed. The build script
# copies the right one into `keystore.properties` at build time (also git-ignored).
#
# Retrieve each keystore from EAS with:
#   cd apps/mobile-app
#   EXPO_PUBLIC_APP_ENV=production  npx eas credentials   # → Android → production → Keystore
#   EXPO_PUBLIC_APP_ENV=development npx eas credentials   # → Android → development → Keystore
#
# Google Play expects (upload key SHA1):
#   com.sweatdrop.app      (prod): 32:0F:C2:DF:D8:63:A0:34:F4:3A:2E:F9:38:D6:D9:4C:49:E7:CA:AE
#   com.sweatdrop.app.dev  (dev) : <locked after first successful upload>
#
# Verify locally before building:
#   keytool -list -v -keystore "<storeFile>" | grep -E "Alias|SHA1"

# Absolute path to the upload keystore (.jks / .keystore) for this env
storeFile=/Users/np/Projects/sweatdrop/apps/mobile-app/android/app/upload-keystore.jks

# Keystore password
storePassword=REPLACE_ME

# Key alias inside the keystore
keyAlias=REPLACE_ME

# Key password — usually identical to storePassword for EAS-generated keystores
keyPassword=REPLACE_ME
