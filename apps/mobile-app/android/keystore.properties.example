# SweatDrop Android upload keystore credentials
#
# Copy this file to `keystore.properties` (same directory) and fill in real values.
# `keystore.properties` is git-ignored and MUST NEVER be committed.
#
# Retrieve the upload keystore from EAS (recommended) with:
#   cd apps/mobile-app && EXPO_PUBLIC_APP_ENV=production npx eas credentials
#   → Android → production → Keystore → Download / Display keystore credentials
#
# Google Play expects the upload AAB to be signed with SHA1:
#   32:0F:C2:DF:D8:63:A0:34:F4:3A:2E:F9:38:D6:D9:4C:49:E7:CA:AE
#
# Verify the local keystore matches before building:
#   keytool -list -v -keystore "<SWEATDROP_UPLOAD_STORE_FILE>" | grep -E "Alias|SHA1"

# Absolute path to the upload keystore (.jks / .keystore)
storeFile=/Users/np/Projects/sweatdrop/apps/mobile-app/android/app/upload-keystore.jks

# Keystore password
storePassword=REPLACE_ME

# Key alias inside the keystore
keyAlias=REPLACE_ME

# Key password — usually identical to storePassword for EAS-generated keystores
keyPassword=REPLACE_ME
