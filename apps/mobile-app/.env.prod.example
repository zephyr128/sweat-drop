# Copy to .env.prod.local (never commit real keys)
EXPO_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-prod-anon-key

EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_PUSH_ENABLED=true
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id

# Website URL for auth email redirects (email confirm, password reset)
# Must match the deployed landing page domain. Used as emailRedirectTo base URL.
EXPO_PUBLIC_SITE_URL=https://www.sweat-drop.com

EXPO_PUBLIC_TERMS_URL=https://your-domain.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://your-domain.com/privacy
