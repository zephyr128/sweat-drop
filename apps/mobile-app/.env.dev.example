# Copy to .env.dev.local (never commit real keys)
EXPO_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key
# Pooler URL for direct DB connections (ORMs, migrations). Not used by JS client.
# SUPABASE_DB_POOLER_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_PUSH_ENABLED=true
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id

EXPO_PUBLIC_TERMS_URL=https://your-domain.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://your-domain.com/privacy
